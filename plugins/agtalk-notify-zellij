#!/bin/sh
# agtalk notify plugin for zellij
# Protocol: discover / send [--dry-run]

set -e

CMD="$1"

if [ "$CMD" = "discover" ]; then
    SESSION="${ZELLIJ_SESSION_NAME:-}"
    PANE="${ZELLIJ_PANE_ID:-}"
    AGENT_NAME="${AGTALK_NOTIFY_NAME:-}"

    if [ -z "$SESSION" ] || [ -z "$PANE" ]; then
        printf '{"version":1,"type":"notify_endpoint","channel":"zellij","ready":false,"endpoint":{},"message":"not in a zellij session"}\n'
        exit 0
    fi

    # Verify the session/pane is reachable from this shell.
    if ! zellij --session "$SESSION" action list-panes >/dev/null 2>&1; then
        printf '{"version":1,"type":"notify_endpoint","channel":"zellij","ready":false,"endpoint":{"session":"%s","pane":"%s"},"message":"zellij action not reachable from current context"}\n' "$SESSION" "$PANE"
        exit 0
    fi

    # If join passed an agent name, rename the target pane to it.
    if [ -n "$AGENT_NAME" ]; then
        zellij --session "$SESSION" action rename-pane --pane-id "$PANE" "$AGENT_NAME" >/dev/null 2>&1 || true
    fi

    printf '{"version":1,"type":"notify_endpoint","channel":"zellij","ready":true,"endpoint":{"session":"%s","pane":"%s"},"message":"zellij session %s, pane %s"}\n' "$SESSION" "$PANE" "$SESSION" "$PANE"
    exit 0
fi

if [ "$CMD" = "send" ]; then
    DRY_RUN=false
    if [ "$2" = "--dry-run" ]; then
        DRY_RUN=true
    fi

    # Read JSON payload from stdin.
    PAYLOAD=$(cat)
    ENDPOINT=$(printf '%s' "$PAYLOAD" | python3 -c 'import sys,json; print(json.dumps(json.load(sys.stdin).get("endpoint",{})))' 2>/dev/null || echo '{}')
    SESSION=$(printf '%s' "$ENDPOINT" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("session",""))' 2>/dev/null || true)
    PANE=$(printf '%s' "$ENDPOINT" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("pane",""))' 2>/dev/null || true)

    if [ -z "$SESSION" ] || [ -z "$PANE" ]; then
        echo "missing endpoint.session or endpoint.pane" >&2
        exit 1
    fi

    if [ "$DRY_RUN" = true ]; then
        if zellij --session "$SESSION" action list-panes >/dev/null 2>&1; then
            exit 0
        fi
        echo "zellij session $SESSION not reachable" >&2
        exit 1
    fi

    # Inject the pre-assembled text from daemon. The payload contains no body/secret.
    TEXT=$(printf '%s' "$PAYLOAD" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("text","[agtalk] 新消息"))' 2>/dev/null || echo "[agtalk] 新消息")

    # Write the command text, then send an Enter keystroke so it executes in the target pane.
    zellij --session "$SESSION" action write-chars --pane-id "$PANE" "$TEXT"
    zellij --session "$SESSION" action write-chars --pane-id "$PANE" "$(printf '\r')"
    exit 0
fi

echo "usage: $0 discover | send [--dry-run]" >&2
exit 1
