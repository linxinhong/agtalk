#!/bin/sh
# agtalk notify plugin for zellij
# Protocol: discover / send [--dry-run]

set -e

CMD="$1"

if [ "$CMD" = "discover" ]; then
    SESSION="${ZELLIJ_SESSION_NAME:-}"
    PANE="${ZELLIJ_PANE_ID:-}"
    AGENT_NAME="${AGTALK_NOTIFY_NAME:-}"

    if [ -z "$SESSION" ] || [ -z "$PANE" ]; then
        printf '{"version":1,"type":"notify_endpoint","channel":"zellij","ready":false,"endpoint":{},"message":"not in a zellij session"}\n'
        exit 0
    fi

    # Verify the session/pane is reachable from this shell.
    if ! zellij --session "$SESSION" action list-panes >/dev/null 2>&1; then
        printf '{"version":1,"type":"notify_endpoint","channel":"zellij","ready":false,"endpoint":{"session":"%s","pane":"%s"},"message":"zellij action not reachable from current context"}\n' "$SESSION" "$PANE"
        exit 0
    fi

    # If join passed an agent name, rename the target pane to it.
    if [ -n "$AGENT_NAME" ]; then
        zellij --session "$SESSION" action rename-pane --pane-id "$PANE" "$AGENT_NAME" >/dev/null 2>&1 || true
    fi

    printf '{"version":1,"type":"notify_endpoint","channel":"zellij","ready":true,"endpoint":{"session":"%s","pane":"%s"},"message":"zellij session %s, pane %s"}\n' "$SESSION" "$PANE" "$SESSION" "$PANE"
    exit 0
fi

if [ "$CMD" = "send" ]; then
    DRY_RUN=false
    if [ "$2" = "--dry-run" ]; then
        DRY_RUN=true
    fi

    # Parse the JSON payload from stdin and validate its version. The python
    # helper emits shell-safe KEY=VALUE lines; capturing into FIELDS first and
    # eval'ing afterwards lets a parse failure propagate under `set -e`
    # (eval "$(...)" would hide the inner failure).
    PAYLOAD=$(cat)
    FIELDS=$(printf '%s' "$PAYLOAD" | python3 -c '
import sys,json,shlex
p=json.load(sys.stdin)
if p.get("version")!=1:
    sys.stderr.write("unsupported payload version\n"); sys.exit(2)
ep=p.get("endpoint",{}) or {}
def kv(k,v): print("%s=%s" % (k, shlex.quote(str(v))))
kv("SESSION", ep.get("session",""))
kv("PANE", ep.get("pane",""))
kv("TEXT", p.get("text","[agtalk] 新消息"))
kv("SEND_ENTER", "1" if p.get("send_enter",True) in (True,"True","true",1) else "0")
') || { echo "zellij plugin: payload 解析失败" >&2; exit 1; }
    eval "$FIELDS"

    if [ -z "$SESSION" ] || [ -z "$PANE" ]; then
        echo "zellij plugin: missing endpoint.session or endpoint.pane" >&2
        exit 1
    fi

    if [ "$DRY_RUN" = true ]; then
        if zellij --session "$SESSION" action list-panes >/dev/null 2>&1; then
            exit 0
        fi
        echo "zellij plugin: session $SESSION not reachable" >&2
        exit 1
    fi

    # Paste the pre-assembled text as bracketed paste. The payload has no body/secret.
    zellij --session "$SESSION" action paste --pane-id "$PANE" "$TEXT"

    # Send Enter only when requested, so the injected command executes.
    if [ "$SEND_ENTER" = "1" ]; then
        zellij --session "$SESSION" action send-keys --pane-id "$PANE" Enter
    fi
    exit 0
fi

echo "usage: $0 discover | send [--dry-run]" >&2
exit 1
