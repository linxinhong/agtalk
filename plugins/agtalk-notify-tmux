#!/bin/sh
# agtalk notify plugin for tmux
# Protocol: discover / send [--dry-run]

set -e

CMD="$1"

if [ "$CMD" = "discover" ]; then
    PANE="${TMUX_PANE:-}"
    if [ -z "$PANE" ] && [ -n "${TMUX:-}" ]; then
        # Try to ask tmux for the current pane id.
        PANE=$(tmux display-message -p '#D' 2>/dev/null || true)
    fi

    if [ -z "$PANE" ]; then
        printf '{"version":1,"type":"notify_endpoint","channel":"tmux","ready":false,"endpoint":{},"message":"not in a tmux session"}\n'
        exit 0
    fi

    if ! tmux list-panes -t "$PANE" >/dev/null 2>&1; then
        printf '{"version":1,"type":"notify_endpoint","channel":"tmux","ready":false,"endpoint":{"pane":"%s"},"message":"tmux pane not reachable from current context"}\n' "$PANE"
        exit 0
    fi

    printf '{"version":1,"type":"notify_endpoint","channel":"tmux","ready":true,"endpoint":{"pane":"%s"},"message":"tmux pane %s"}\n' "$PANE" "$PANE"
    exit 0
fi

if [ "$CMD" = "send" ]; then
    DRY_RUN=false
    if [ "$2" = "--dry-run" ]; then
        DRY_RUN=true
    fi

    PAYLOAD=$(cat)
    ENDPOINT=$(printf '%s' "$PAYLOAD" | python3 -c 'import sys,json; print(json.dumps(json.load(sys.stdin).get("endpoint",{})))' 2>/dev/null || echo '{}')
    PANE=$(printf '%s' "$ENDPOINT" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("pane",""))' 2>/dev/null || true)

    if [ -z "$PANE" ]; then
        echo "missing endpoint.pane" >&2
        exit 1
    fi

    if [ "$DRY_RUN" = true ]; then
        if tmux list-panes -t "$PANE" >/dev/null 2>&1; then
            exit 0
        fi
        echo "tmux pane $PANE not reachable" >&2
        exit 1
    fi

    # Inject the pre-assembled text from daemon. The payload contains no body/secret.
    TEXT=$(printf '%s' "$PAYLOAD" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("text","[agtalk] 新消息"))' 2>/dev/null || echo "[agtalk] 新消息")

    SEND_ENTER=$(printf '%s' "$PAYLOAD" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("send_enter",True))' 2>/dev/null || echo "True")
    if [ "$SEND_ENTER" = "True" ] || [ "$SEND_ENTER" = "true" ]; then
        tmux send-keys -t "$PANE" -R "$TEXT" Enter
    else
        tmux send-keys -t "$PANE" -R "$TEXT"
    fi
    exit 0
fi

echo "usage: $0 discover | send [--dry-run]" >&2
exit 1
