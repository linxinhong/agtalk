#!/bin/sh
# agtalk notify plugin for tmux
# Protocol: discover / send [--dry-run]

set -e

CMD="$1"

if [ "$CMD" = "discover" ]; then
    PANE="${TMUX_PANE:-}"
    if [ -z "$PANE" ] && [ -n "${TMUX:-}" ]; then
        # Try to ask tmux for the current pane id.
        PANE=$(tmux display-message -p '#D' 2>/dev/null || true)
    fi

    if [ -z "$PANE" ]; then
        printf '{"version":1,"type":"notify_endpoint","channel":"tmux","ready":false,"endpoint":{},"message":"not in a tmux session"}\n'
        exit 0
    fi

    if ! tmux list-panes -t "$PANE" >/dev/null 2>&1; then
        printf '{"version":1,"type":"notify_endpoint","channel":"tmux","ready":false,"endpoint":{"pane":"%s"},"message":"tmux pane not reachable from current context"}\n' "$PANE"
        exit 0
    fi

    printf '{"version":1,"type":"notify_endpoint","channel":"tmux","ready":true,"endpoint":{"pane":"%s"},"message":"tmux pane %s"}\n' "$PANE" "$PANE"
    exit 0
fi

if [ "$CMD" = "send" ]; then
    DRY_RUN=false
    if [ "$2" = "--dry-run" ]; then
        DRY_RUN=true
    fi

    # Parse the JSON payload from stdin and validate its version. The python
    # helper emits shell-safe KEY=VALUE lines; capturing into FIELDS first and
    # eval'ing afterwards lets a parse failure propagate under `set -e`
    # (eval "$(...)" would hide the inner failure).
    PAYLOAD=$(cat)
    FIELDS=$(printf '%s' "$PAYLOAD" | python3 -c '
import sys,json,shlex
p=json.load(sys.stdin)
if p.get("version")!=1:
    sys.stderr.write("unsupported payload version\n"); sys.exit(2)
ep=p.get("endpoint",{}) or {}
def kv(k,v): print("%s=%s" % (k, shlex.quote(str(v))))
kv("PANE", ep.get("pane",""))
kv("TEXT", p.get("text","[agtalk] 新消息"))
kv("SEND_ENTER", "1" if p.get("send_enter",True) in (True,"True","true",1) else "0")
') || { echo "tmux plugin: payload 解析失败" >&2; exit 1; }
    eval "$FIELDS"

    if [ -z "$PANE" ]; then
        echo "tmux plugin: missing endpoint.pane" >&2
        exit 1
    fi

    if [ "$DRY_RUN" = true ]; then
        if tmux list-panes -t "$PANE" >/dev/null 2>&1; then
            exit 0
        fi
        echo "tmux plugin: pane $PANE not reachable" >&2
        exit 1
    fi

    # Inject the pre-assembled text. The payload has no body/secret.
    tmux send-keys -t "$PANE" -R "$TEXT"

    # Send Enter only when requested, so the injected command executes.
    if [ "$SEND_ENTER" = "1" ]; then
        # TUI（如 Kimi Code）对高速连续输入有粘贴检测：Enter 与文本同次到达会被
        # 当成粘贴内容的换行而非提交。留 0.5s 间隔让 TUI 脱离"粘贴态"。
        # 注意整体耗时受 daemon 插件 timeout（默认 1000ms）限制，超时需调大
        # notify.plugins.tmux.timeout_ms。
        sleep 0.5
        tmux send-keys -t "$PANE" Enter
    fi
    exit 0
fi

echo "usage: $0 discover | send [--dry-run]" >&2
exit 1
